set(PETALINUX_ROOT "/opt/petalinux/2023.1")
set(PETALINUX_HOST "${PETALINUX_ROOT}/sysroots/x86_64-petalinux-linux")
set(PETALINUX_TARGET "${PETALINUX_ROOT}/sysroots/cortexa72-cortexa53-xilinx-linux")
set(PETALINUX_TRIPLE "aarch64-xilinx-linux")
set(PETALINUX_BIN "${PETALINUX_HOST}/usr/bin/${PETALINUX_TRIPLE}")

set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_SYSROOT "${PETALINUX_TARGET}")

set(CMAKE_C_COMPILER "${PETALINUX_BIN}/${PETALINUX_TRIPLE}-gcc")
set(CMAKE_CXX_COMPILER "${PETALINUX_BIN}/${PETALINUX_TRIPLE}-g++")
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a72")
set(CMAKE_CXX_FLAGS_INIT "-mcpu=cortex-a72")

set(CMAKE_FIND_ROOT_PATH "${PETALINUX_TARGET}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
